# Public site URL used for metadata / canonical links.
# NEXT_PUBLIC_SITE_URL=https://nolza.fun

# Google AdSense configuration.
# Leave NEXT_PUBLIC_ADSENSE_CLIENT unset (or keep the "ca-pub-XXX..." placeholder)
# to disable ads entirely; components render null and the AdSense script is not loaded.
# Set all four to enable ads in production.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT_TOP=XXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=XXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT_MOBILE=XXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT_SIDE=XXXXXXXXXX

# Google Analytics 4.
# Replace the placeholder with the real GA4 Measurement ID to enable analytics.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Zero to Studio / Studio4Any feedback SDK.
# The app has a production fallback project key for nolza, but these can override it.
# NEXT_PUBLIC_ZERO_TO_STUDIO_PROJECT_KEY=zts_pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_ZERO_TO_STUDIO_SDK_SRC=https://studio4any.com/v1/sdk.js
# NEXT_PUBLIC_ZERO_TO_STUDIO_FEEDBACK_SLUG=nolza

# Google Search Console verification.
# Only set this when Google provides a real verification token.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxx

# Result stats store (Upstash Redis / Vercel KV) — powers the "World Cup ranking"
# live tally on the football player tests (football-kr / football-global).
# When unset, the stats API returns empty and the UI shows a "being tallied"
# message (never fake numbers).
# On Vercel: add the Upstash/KV integration and these are injected automatically.
# Locally: copy the REST URL + token from the Upstash/Vercel KV dashboard.
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
